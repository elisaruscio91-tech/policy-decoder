# Copiare in .env (mai committare .env — è già in .gitignore).
# In produzione (Coolify) queste variabili si impostano nella UI del progetto,
# non tramite questo file.

# Porta HTTP del server (Main.scala legge $PORT, fallback 8080).
PORT=8080

# Connection string Postgres, stesso formato usato prima con Prisma:
# postgresql://user:password@host:port/db
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Sessione JWT (login email+password, +2FA opzionale) firmata con questo
# segreto: obbligatoria. Generarne uno con `openssl rand -base64 32`.
# Account creati/rinnovati manualmente con InvitaUtente/Abilita2fa (vedi
# README.md § CLI di amministrazione) — nessuna registrazione self-service.
JWT_SECRET=

# --- Motore di analisi ----------------------------------------------------
# AI_PROVIDER: "anthropic" (qualità migliore, prompt tarato su Claude, dati
#              inviati ad Anthropic) | "openrouter" (modelli open-source via
#              terzi, pay-per-token) | "ollama" (modello open-source
#              autogestito sulla tua VM, massima privacy: il testo non esce
#              dalla tua infrastruttura).
# Vedi README.md § "Sostenibilità dei costi" per il confronto completo.
AI_PROVIDER=anthropic

# Richiesta se AI_PROVIDER=anthropic. Letta solo lato server (MotoreIA.scala).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Necessaria solo se la chiave API non è associata a un workspace di default
# (Console Anthropic → Settings → API Keys mostra l'errore se serve).
ANTHROPIC_WORKSPACE_ID=

# Richieste se AI_PROVIDER=openrouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Richieste se AI_PROVIDER=ollama: URL del tuo Ollama self-hosted (raggiungibile
# dal container backend, es. http://ollama:11434 su una rete Coolify interna).
# OLLAMA_API_KEY è opzionale, solo se metti un reverse proxy con auth davanti.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:32b

# Quota mensile di default per chi non ha una riga whitelist_entry con
# limite_mensile personalizzato (usata solo come fallback difensivo).
DEFAULT_MONTHLY_QUOTA=5

# --- Archivio fonti (RAG) --------------------------------------------------
# Modello di embedding usato da Fonti/Embeddings/IngestaFonte, sempre via
# OLLAMA_BASE_URL (self-hosted) indipendentemente da AI_PROVIDER: i testi
# delle tue fonti private non escono mai dalla tua infrastruttura, anche se
# scegli un provider esterno per l'analisi vera e propria. Se cambi modello,
# la dimensione del vettore va adattata in
# db/migration/V2__fonti_pgvector.sql PRIMA del primo avvio.
EMBEDDING_MODEL=nomic-embed-text
