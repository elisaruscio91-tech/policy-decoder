# Copiare in .env.local (mai committare .env.local — è già in .gitignore)

# URL pubblico del sito (metadata, link nelle email di accesso).
NEXT_PUBLIC_SITE_URL=https://policy-decoder.vercel.app

# Connection string Postgres (Neon). Richiesta per `npx prisma migrate deploy`
# e per ogni funzione che usi src/lib/prisma.ts (whitelist, quota, log sicurezza).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Login magic-link (NextAuth) ristretto alla whitelist attiva.
# AUTH_SECRET: generare con `npx auth secret` (obbligatoria in produzione).
# RESEND_API_KEY: chiave API Resend per l'invio del link di accesso.
# AUTH_EMAIL_FROM: mittente mostrato nell'email (es. "Policy Decoder <accesso@tuodominio.it>").
AUTH_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# --- Motore di analisi ----------------------------------------------------
# AI_PROVIDER: "anthropic" (qualità migliore, prompt tarato su Claude, dati
#              inviati ad Anthropic) | "openrouter" (modelli open-source via
#              terzi, pay-per-token) | "ollama" (modello open-source
#              autogestito sulla tua VM, massima privacy: il testo non esce
#              dalla tua infrastruttura).
# Vedi README.md § "Sostenibilità dei costi" per il confronto completo.
AI_PROVIDER=anthropic

# Richiesta se AI_PROVIDER=anthropic. NON esporre mai lato client: viene letta
# solo dalle API route server-side (src/app/api/analyze/route.ts).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Necessaria solo se la chiave API non è associata a un workspace di default
# (Console Anthropic → Settings → API Keys mostra l'errore se serve).
ANTHROPIC_WORKSPACE_ID=

# Richieste se AI_PROVIDER=openrouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Richieste se AI_PROVIDER=ollama: URL del tuo Ollama self-hosted (VM/VPS
# raggiungibile dalle API route di Vercel, es. https://ollama.tuodominio.it).
# OLLAMA_API_KEY è opzionale, solo se metti un reverse proxy con auth davanti.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:32b

# Quota mensile di default per chi non ha una riga WhitelistEntry con
# limiteMensile personalizzato (usata solo come fallback difensivo).
DEFAULT_MONTHLY_QUOTA=5
