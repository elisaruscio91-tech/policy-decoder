<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Livello di default: WARN. Senza questo file, logback usa il default
       (DEBUG su tutto), che stampa anche gli header HTTP delle chiamate in
       uscita — incluso "x-api-key" con la chiave Anthropic in chiaro. -->
  <root level="WARN">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
