// Prisma schema — Policy Decoder
// Pattern ripreso da res-publica: whitelist di accesso + NextAuth (magic link)
// + log di sicurezza per rilevare brute-force/DoS.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Whitelist di accesso -------------------------------------------------
// Solo le email qui presenti possono completare il login magic-link
// (controllo nel callback signIn di NextAuth). "scadenza" rappresenta la
// validità dell'abbonamento: null = accesso senza scadenza (es. admin/staff),
// altrimenti va rinnovata ad ogni ciclo di fatturazione dell'abbonamento
// gestito fuori da questa app (vedi scripts/invita-utente.ts).
model WhitelistEntry {
  id            String    @id @default(cuid())
  email         String    @unique
  fonte         String // es. "abbonamento", "staff", "beta-tester"
  scadenza      DateTime? // null = nessuna scadenza
  limiteMensile Int       @default(5) // analisi consentite per mese solare
  createdAt     DateTime  @default(now())
}

// --- Autenticazione (schema standard richiesto da @auth/prisma-adapter) ---
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  richieste AnalisiRichiesta[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Log di sicurezza (rilevazione brute-force/DoS su login e /api/analyze) ---
// Retention breve consigliata (es. cron di pulizia oltre i 30 giorni),
// non usato per profilazione utenti.
model EventoSicurezza {
  id        String   @id @default(cuid())
  ip        String
  endpoint  String // es. "/api/auth/signin", "/api/analyze", "/api/fetch-url"
  esito     String // "successo" | "fallimento" | "rate-limited"
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([endpoint, createdAt])
}

// --- Log delle analisi (quota mensile + analytics d'uso) -----------------
// Ogni chiamata (riuscita o no) a /api/analyze viene registrata. La quota
// mensile si calcola contando le righe "successo" del mese solare corrente
// per utente — nessun job di reset separato necessario.
model AnalisiRichiesta {
  id               String   @id @default(cuid())
  userId           String
  modalita         String // "testo" | "url"
  lunghezzaInput   Int // caratteri del testo analizzato
  dangerScore      Int?
  esito            String // "successo" | "errore" | "rate-limited" | "quota-esaurita"
  erroreMessaggio  String?
  durataMs         Int?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
